# Vite exposes only variables prefixed with VITE_ to the browser bundle.
# They are inlined at BUILD time, so on Vercel they must be set as build-time
# environment variables (Settings > Environment Variables), not runtime ones.

# Clerk publishable key (Dashboard > Configure > API Keys).
VITE_CLERK_PUBLISHABLE_KEY=

# Set to "true" to use VITE_CLERK_PUBLISHABLE_KEY verbatim.
# Leave unset on Replit, where the key is derived from the served host so that
# several custom domains can map to several Clerk instances.
VITE_CLERK_PIN_PUBLISHABLE_KEY=true

# Optional: only needed when Clerk traffic is routed through the API server.
#VITE_CLERK_PROXY_URL=

# --- Hosting-only knobs (never required for `vite build`) ---
# Replit injects both. Vercel/CI can ignore them: the Vite config now falls
# back to PORT=3000 (dev/preview only) and BASE_PATH=/ (domain root).
#PORT=3000
#BASE_PATH=/

# --- Obligatoires (Serverless Function Vercel comme conteneur) ---

# Chaîne de connexion Postgres. lib/db/src/index.ts lève au chargement sans elle.
# Sur Vercel chaque instance de fonction ouvre son propre pool pg : pointer vers
# un pooler (Neon / Supabase / RDS Proxy), pas vers la connexion directe.
DATABASE_URL=

# Sans CLERK_SECRET_KEY, tous les /api/* renvoient 500 "Missing Clerk Secret Key".
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Emplacement du stockage privé, ex. /mon-bucket/sillage-private
PRIVATE_OBJECT_DIR=
# Chemins publics de recherche, séparés par des virgules, ex. mon-bucket/public
PUBLIC_OBJECT_SEARCH_PATHS=

# --- Stockage objet ---

# Auto-détecté : "replit" si REPL_ID est défini (sidecar 127.0.0.1:1106),
# "gcs" sinon (Application Default Credentials + URL signées v4).
#OBJECT_STORAGE_PROVIDER=gcs

# Hors Replit : JSON d'un service account, ou workload identity du runtime.
#GOOGLE_APPLICATION_CREDENTIALS=
#GCS_PROJECT_ID=

# --- Optionnel ---

#LOG_LEVEL=info
